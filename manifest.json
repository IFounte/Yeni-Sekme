{
  "manifest_version": 3,
  "name": "Özel Yeni Sekme",
  "version": "1.0.0",
  "description": "Kişiselleştirilebilir modern yeni sekme sayfası. Hızlı arama, saat, tarih ve favori linkler.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Özel Yeni Sekme"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
